                tmp_sql = tmp_sql & " 				WHEN HYK.nkin_kbn = 1 THEN 1 "
                tmp_sql = tmp_sql & " 				WHEN HYK.nkin_kbn = 2 THEN 2 "
                tmp_sql = tmp_sql & " 				WHEN HYK.nkin_kbn = 3 THEN 3 "
                tmp_sql = tmp_sql & " 				WHEN koteihendo_kbn = 1 AND HYK.nkin_kbn = 5 THEN 1 "
                tmp_sql = tmp_sql & " 				WHEN koteihendo_kbn = 2 AND HYK.nkin_kbn = 5 THEN 5 "
                tmp_sql = tmp_sql & " 				ELSE NULL "
                tmp_sql = tmp_sql & " 			 END AS [月々/契約時/更新時区分] "
                tmp_sql = tmp_sql & " 			,HYK.nkin_no "
                tmp_sql = tmp_sql & " 			,[最大送金率] AS [送金率] "
                tmp_sql = tmp_sql & " 			,[最大管理手数料率] AS [管理手数料率] "
                tmp_sql = tmp_sql & " 		FROM hy_kanri AS HYK "
                tmp_sql = tmp_sql & " 		/*20160725 送金ルール入金項目情報抽出クエリ修正 add*/ "
                tmp_sql = tmp_sql & " 		LEFT JOIN bk_kanri AS BKK ON HYK.bk_no = BKK.bk_no "
                tmp_sql = tmp_sql & " 		LEFT JOIN "
                tmp_sql = tmp_sql & " 		( "
                tmp_sql = tmp_sql & " 			/*最大管理手数料率・送金率をVIEW化 sta*/ "
                tmp_sql = tmp_sql & " 			SELECT DISTINCT "
                tmp_sql = tmp_sql & " 				 HYKKANRITESURITU.bk_no "
                tmp_sql = tmp_sql & " 				/*20160725 送金ルール入金項目情報抽出クエリ修正 add*/ "
                tmp_sql = tmp_sql & " 				,HYKKANRITESURITU.kn_no "
                tmp_sql = tmp_sql & " 				,HYKKANRITESURITU.nkin_no "
                tmp_sql = tmp_sql & " 				,[最大管理手数料率] "
                tmp_sql = tmp_sql & " 				,[最大送金率] "
                tmp_sql = tmp_sql & " 			FROM "
                tmp_sql = tmp_sql & " 			( "
                tmp_sql = tmp_sql & " 				/*最大管理手数料率の抽出 sta*/ "
                tmp_sql = tmp_sql & " 				SELECT "
                tmp_sql = tmp_sql & " 					 HYK.bk_no "
                tmp_sql = tmp_sql & " 					/*20160725 送金ルール入金項目情報抽出クエリ修正 add*/ "
                tmp_sql = tmp_sql & " 					,BKK.kn_no "
                tmp_sql = tmp_sql & " 					,nkin_no "
                tmp_sql = tmp_sql & " 					,MAX([管理手数料率]) AS [最大管理手数料率] "
                tmp_sql = tmp_sql & " 				FROM hy_kanri AS HYK "
                tmp_sql = tmp_sql & " 				LEFT JOIN bk_kanri AS BKK ON HYK.bk_no = BKK.bk_no "
                tmp_sql = tmp_sql & " 				LEFT JOIN "
                tmp_sql = tmp_sql & " 					( "
                tmp_sql = tmp_sql & " 						/*管理手数料率をマスタ化 sta*/ "
                tmp_sql = tmp_sql & " 						SELECT * FROM "
                tmp_sql = tmp_sql & " 						( "
                tmp_sql = tmp_sql & " 							SELECT bk_no,kn_no,1 AS [管理手数料率No],kanritesu_rit1 AS [管理手数料率] FROM bk_kanri "
                tmp_sql = tmp_sql & " 							UNION "
                tmp_sql = tmp_sql & " 							SELECT bk_no,kn_no,2 AS [管理手数料率No],kanritesu_rit2 AS [管理手数料率] FROM bk_kanri "
                tmp_sql = tmp_sql & " 							UNION "
                tmp_sql = tmp_sql & " 							SELECT bk_no,kn_no,3 AS [管理手数料率No],kanritesu_rit3 AS [管理手数料率] FROM bk_kanri "
                tmp_sql = tmp_sql & " 							UNION "
                tmp_sql = tmp_sql & " 							SELECT bk_no,kn_no,4 AS [管理手数料率No],kanritesu_rit4 AS [管理手数料率] FROM bk_kanri "
                tmp_sql = tmp_sql & " 							UNION "
                tmp_sql = tmp_sql & " 							SELECT bk_no,kn_no,5 AS [管理手数料率No],kanritesu_rit5 AS [管理手数料率] FROM bk_kanri "
                tmp_sql = tmp_sql & " 						) AS VW "
                tmp_sql = tmp_sql & " 						WHERE [管理手数料率] <> 0 "
                tmp_sql = tmp_sql & " 						/*管理手数料率をマスタ化 end*/ "
                tmp_sql = tmp_sql & " 					) AS KANRIRYOMST "
                tmp_sql = tmp_sql & " 				ON  HYK.bk_no = KANRIRYOMST.bk_no "
                tmp_sql = tmp_sql & " 				AND BKK.kn_no = KANRIRYOMST.kn_no "
                tmp_sql = tmp_sql & " 				AND HYK.kn_ritno = KANRIRYOMST.[管理手数料率No] "
                tmp_sql = tmp_sql & " 				/*20160725 送金ルール入金項目情報抽出クエリ修正 chg sta*/ "
                tmp_sql = tmp_sql & " 				/*GROUP BY HYK.bk_no,nkin_no*/ "
                tmp_sql = tmp_sql & " 				GROUP BY HYK.bk_no,BKK.kn_no,nkin_no "
                tmp_sql = tmp_sql & " 				/*20160725 送金ルール入金項目情報抽出クエリ修正 chg end*/ "
                tmp_sql = tmp_sql & " 				/*最大管理手数料率の抽出 end*/ "
                tmp_sql = tmp_sql & " 			) AS HYKKANRITESURITU "
                tmp_sql = tmp_sql & " 			LEFT JOIN "
                tmp_sql = tmp_sql & " 			( "
                tmp_sql = tmp_sql & " 				/*最大送金率の抽出 sta*/ "
                tmp_sql = tmp_sql & " 				SELECT "
                tmp_sql = tmp_sql & " 					 bk_no "
                tmp_sql = tmp_sql & " 					,nkin_no "
                tmp_sql = tmp_sql & " 					,MAX(sokin_rit) AS [最大送金率] "
                tmp_sql = tmp_sql & " 				FROM hy_kanri "
                tmp_sql = tmp_sql & " 				GROUP BY bk_no,nkin_no "
                tmp_sql = tmp_sql & " 				/*最大送金率の抽出 end*/ "
                tmp_sql = tmp_sql & " 			) AS HYKSOKINRITU "
                tmp_sql = tmp_sql & " 			ON  HYKKANRITESURITU.bk_no = HYKSOKINRITU.bk_no "
                tmp_sql = tmp_sql & " 			AND HYKKANRITESURITU.nkin_no = HYKSOKINRITU.nkin_no "
                tmp_sql = tmp_sql & " 			/*最大管理手数料率・送金率をVIEW化 end*/ "
                tmp_sql = tmp_sql & " 		) AS HYKANRISOKINTOTAL "
                tmp_sql = tmp_sql & " 		ON  HYK.bk_no = HYKANRISOKINTOTAL.bk_no "
                tmp_sql = tmp_sql & " 		/*20160725 送金ルール入金項目情報抽出クエリ修正 add*/ "
                tmp_sql = tmp_sql & " 		AND BKK.kn_no = HYKANRISOKINTOTAL.kn_no "
                tmp_sql = tmp_sql & " 		AND HYK.nkin_no = HYKANRISOKINTOTAL.nkin_no "
                tmp_sql = tmp_sql & " 	) AS HYKANRI "
                tmp_sql = tmp_sql & " 	/*20160725 送金ルール入金項目情報抽出クエリ修正 chg sta*/ "
                tmp_sql = tmp_sql & " 	/*LEFT JOIN (SELECT bk_no,kn_no,tnh_umu FROM bk_kanri) AS BKK ON HYKANRI.bk_no = BKK.bk_no*/ "
                tmp_sql = tmp_sql & " 	LEFT JOIN (SELECT bk_no,kn_no,tnh_umu FROM bk_kanri) AS BKK "
                tmp_sql = tmp_sql & " 	ON  HYKANRI.bk_no = BKK.bk_no "
                tmp_sql = tmp_sql & " 	AND HYKANRI.kn_no = BKK.kn_no "
                tmp_sql = tmp_sql & " 	/*20160725 送金ルール入金項目情報抽出クエリ修正 chg end*/ "
                tmp_sql = tmp_sql & " 	LEFT JOIN m_nkin AS MN ON HYKANRI.nkin_no = MN.nkin_no "
                tmp_sql = tmp_sql & " 	/*LEFT JOIN bk_sokin AS BKS ON BKK.bk_no = BKS.bk_no AND BKK.kn_no = BKS.kn_no*/ "
                tmp_sql = tmp_sql & " 	WHERE [月々/契約時/更新時区分] IS NOT NULL "
                tmp_sql = tmp_sql & " 	/*部屋入金項目情報から実データ抽出 end*/ "
                tmp_sql = tmp_sql & " 	/*20160928 送金ルールその他請求取得処理修正 del sta*/ "
                tmp_sql = tmp_sql & " 	/*プログラム内で自動作成する処理へ修正*/ "
                tmp_sql = tmp_sql & " 	/* "
                tmp_sql = tmp_sql & " 	UNION "
                tmp_sql = tmp_sql & " 	/*送金ルール作成時にその他請求のレコードが生成されるためダミーレコードを作成しておく sta*/ "
                tmp_sql = tmp_sql & " 	SELECT DISTINCT "
                tmp_sql = tmp_sql & " 		 HYK.bk_no AS [物件No] "
                tmp_sql = tmp_sql & " 		,'' AS [部屋No] "
                tmp_sql = tmp_sql & " 		,BKK.kn_no AS [送金ルール管理No] "
                tmp_sql = tmp_sql & " 		,7 AS [月々/契約時/更新時区分] "
                tmp_sql = tmp_sql & " 		,1 AS [行NO] "
                tmp_sql = tmp_sql & " 		/*,NULL AS [入金項目No]*/ "
                tmp_sql = tmp_sql & " 		,'挿入用' AS [入金項目名] "
                tmp_sql = tmp_sql & " 		,100 AS [送金率] "
                tmp_sql = tmp_sql & " 		,100 AS [管理手数料率] "
                tmp_sql = tmp_sql & " 		,tnh_umu AS [滞納保証有無] "
                tmp_sql = tmp_sql & " 		/*,so_no AS [送金先No]*/	/*使用されていない可能性あり(画面上で入金項目毎の送金先設定箇所が不明のため)*/ "
                tmp_sql = tmp_sql & " 		,NULL  AS [送金先No] "
                tmp_sql = tmp_sql & " 	FROM hy_kanri HYK "
                tmp_sql = tmp_sql & " 	LEFT JOIN (SELECT bk_no,kn_no,tnh_umu FROM bk_kanri) AS BKK ON HYK.bk_no = BKK.bk_no "
                tmp_sql = tmp_sql & " 	LEFT JOIN bk_sokin AS BKS ON HYK.bk_no = BKK.bk_no "
                tmp_sql = tmp_sql & " 	LEFT JOIN m_nkin AS MN ON HYK.nkin_no = MN.nkin_no "
                tmp_sql = tmp_sql & " 	/*送金ルール作成時にその他請求のレコードが生成されるためダミーレコードを作成しておく end*/ "
                tmp_sql = tmp_sql & " 	*/ "
                tmp_sql = tmp_sql & " 	/*20160928 送金ルールその他請求取得処理修正 del end*/ "
                tmp_sql = tmp_sql & " ) AS TOTAL "
                tmp_sql = tmp_sql & " /*2016.04.06 送金ルール入金/控除項目取得条件の追加 add*/ "
                tmp_sql = tmp_sql & " WHERE [送金ルール管理No] IS NOT NULL "

                Return tmp_sql

            End Function

