                tmp_sql = tmp_sql & " 							,* "
                tmp_sql = tmp_sql & " 						FROM bk_sokin "
                tmp_sql = tmp_sql & " 					) AS BKS "
                tmp_sql = tmp_sql & " 					WHERE EXISTS "
                tmp_sql = tmp_sql & " 						( "
                tmp_sql = tmp_sql & " 							SELECT * FROM bk_kanri AS BKK "
