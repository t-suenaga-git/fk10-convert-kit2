                'tmp_sql = tmp_sql & " 	,so_dd5 AS [送金日決定方法5 - 送金締日] "
                'tmp_sql = tmp_sql & " 	,1 AS [送金先単独/複数指定] "
                'tmp_sql = tmp_sql & " 	,sokin_kbn AS [送金固定額使用フラグ] "
                'tmp_sql = tmp_sql & " 	,[金額指定口座数]  AS [送金固定数]	/*物件送金情報から取得した金額指定の口座数をセット*/ "
                'tmp_sql = tmp_sql & " 	,1 AS [均等案分フラグ] "
