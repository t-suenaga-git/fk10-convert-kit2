    Public Class Hy_kanri_sorulekojo_Repository

        Public Class SubConv
            Implements IConv

            ''' <summary>
            ''' 【抽出クエリ】
            ''' </summary>
            ''' <returns></returns>
            ''' <remarks></remarks>
            Function Get_UseQry(ByRef sortstr As String) As String Implements IConv.Get_UseQry

                Dim tmp_sql As String = ""

                sortstr = "[物件No],[送金ルール管理No],[契約時/更新時区分],[行NO]"

                '抽出データの改行文字列を除去する暫定処理
                Dim tmp_midheader As String = "[物件No],[部屋No],[送金ルール管理No],[契約時/更新時区分],[行NO],[控除入金項目名],[相殺予定フラグ],[控除額基準],[控除額],[控除額税区分],[控除対象入金項目名],[控除率],[控除率税区分],[控除率税有無],[適用税率],[立替回収または預り金],[控除税額],[送金対象フラグ],[送金対象入金項目名]"
                Dim tmp_chgmidheader As String = EtcMethod.Get_FldnameAddReplaceMethod(tmp_midheader, True)
                '抽出データの改行文字列を除去する暫定処理

                'tmp_sql = tmp_sql & " SELECT * FROM "
                tmp_sql = tmp_sql & " SELECT " & tmp_chgmidheader & " FROM "
                tmp_sql = tmp_sql & " ( "
                tmp_sql = tmp_sql & " 	SELECT "
                tmp_sql = tmp_sql & " 		 bk_no AS [物件No] "
                tmp_sql = tmp_sql & " 		,'' AS [部屋No] "
                tmp_sql = tmp_sql & " 		,kn_no AS [送金ルール管理No] "
                tmp_sql = tmp_sql & " 		,[契約時/更新時区分] "
                tmp_sql = tmp_sql & " 		,ROW_NUMBER()OVER(PARTITION BY bk_no,kn_no,[契約時/更新時区分] ORDER BY nkin_no) AS [行NO] "
                tmp_sql = tmp_sql & " 		/*,nkin_no AS [入金項目No]*/ "
                tmp_sql = tmp_sql & " 		,nkin_name AS [控除入金項目名] "
                tmp_sql = tmp_sql & " 		,sosai_umu AS [相殺予定フラグ] "
                tmp_sql = tmp_sql & " 		,2 AS [控除額基準] "
                tmp_sql = tmp_sql & " 		,sq_gak AS [控除額] "
                tmp_sql = tmp_sql & " 		,CASE "
                tmp_sql = tmp_sql & " 			WHEN sq_zeiumu = 0 THEN 1 "
                tmp_sql = tmp_sql & " 			WHEN sq_zeiumu = 1 THEN 2 "
                tmp_sql = tmp_sql & " 			ELSE 2 "
                tmp_sql = tmp_sql & " 		 END AS [控除額税区分] "
                tmp_sql = tmp_sql & " 		,'挿入用' AS [控除対象入金項目名] "
                tmp_sql = tmp_sql & " 		,NULL AS [控除率] "
                tmp_sql = tmp_sql & " 		,2 AS [控除率税区分] "
                tmp_sql = tmp_sql & " 		,0 AS [控除率税有無] "
                tmp_sql = tmp_sql & " 		,NULL AS [適用税率] "
                tmp_sql = tmp_sql & " 		,0 AS [立替回収または預り金] "
                tmp_sql = tmp_sql & " 		,0 AS [控除税額] "
                tmp_sql = tmp_sql & " 		,0 AS [送金対象フラグ] "
                tmp_sql = tmp_sql & " 		,'挿入用' [送金対象入金項目名]	 "
                tmp_sql = tmp_sql & " 	FROM "
                tmp_sql = tmp_sql & " 	( "
                tmp_sql = tmp_sql & " 		/*金額が最大の入金項目のみ抽出する sta*/ "
                tmp_sql = tmp_sql & " 		SELECT * FROM "
                tmp_sql = tmp_sql & " 		( "
                tmp_sql = tmp_sql & " 			SELECT "
                tmp_sql = tmp_sql & " 				 ROW_NUMBER()OVER(PARTITION BY bk_no,kn_no,[契約時/更新時区分],nkin_no ORDER BY sq_gak DESC) AS [抽出用] "
                tmp_sql = tmp_sql & " 				,* "
                tmp_sql = tmp_sql & " 			FROM "
                tmp_sql = tmp_sql & " 			( "
                tmp_sql = tmp_sql & " 				SELECT "
                tmp_sql = tmp_sql & " 					 HYK.bk_no "
                tmp_sql = tmp_sql & " 					,BKK.kn_no "
                tmp_sql = tmp_sql & " 					,CASE "
                tmp_sql = tmp_sql & " 						WHEN HYK.nkin_kbn = 7 AND ISNULL(HYK.yobi_si1,0) = 0 THEN 2 "
                tmp_sql = tmp_sql & " 						WHEN HYK.nkin_kbn = 7 AND ISNULL(HYK.yobi_si1,0) = 1 THEN 3 "
                tmp_sql = tmp_sql & " 						ELSE NULL "
                tmp_sql = tmp_sql & " 					 END AS [契約時/更新時区分]				 "
                tmp_sql = tmp_sql & " 					,HYK.nkin_no "
                tmp_sql = tmp_sql & " 					,nkin_name "
                tmp_sql = tmp_sql & " 					,sosai_umu "
                tmp_sql = tmp_sql & " 					,sq_gak "
                tmp_sql = tmp_sql & " 					,sq_zeiumu "
                tmp_sql = tmp_sql & " 				FROM hy_kanri AS HYK "
                tmp_sql = tmp_sql & " 				LEFT JOIN bk_kanri AS BKK ON HYK.bk_no = BKK.bk_no "
                tmp_sql = tmp_sql & " 				LEFT JOIN m_nkin AS MN ON HYK.nkin_no = MN.nkin_no "
                tmp_sql = tmp_sql & " 				LEFT JOIN bk_sokin AS BKS ON BKK.bk_no = BKS.bk_no AND BKK.kn_no = BKS.kn_no "
                tmp_sql = tmp_sql & " 			) AS VW1 "
                tmp_sql = tmp_sql & " 		) AS VW2 "
                tmp_sql = tmp_sql & " 		WHERE [抽出用] = 1 "
                tmp_sql = tmp_sql & " 		/*金額が最大の入金項目のみ抽出する end*/ "
                tmp_sql = tmp_sql & " 	) AS VW3 "
                tmp_sql = tmp_sql & " 	WHERE [契約時/更新時区分] IS NOT NULL "
                tmp_sql = tmp_sql & " ) AS TOTAL "
                tmp_sql = tmp_sql & " /*2016.04.06 送金ルール入金/控除項目取得条件の追加 add*/ "
                tmp_sql = tmp_sql & " WHERE [送金ルール管理No] IS NOT NULL "

                Return tmp_sql

            End Function

