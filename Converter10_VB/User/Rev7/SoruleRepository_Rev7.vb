                tmp_sql = tmp_sql & " 		UNION "
                tmp_sql = tmp_sql & " 		/*革命10では自動で3レコード生成されるため、3レコード目のダミーレコードを作成して結合する sta*/ "
                tmp_sql = tmp_sql & " 		SELECT DISTINCT "
                tmp_sql = tmp_sql & " 			 bk_no AS [物件No] "
