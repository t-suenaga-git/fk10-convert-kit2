                tmp_sql = tmp_sql & " 							AND   BKK.sokin_kbn = 0 "
                tmp_sql = tmp_sql & " 							AND   BKS.daihyo = 1 "
                tmp_sql = tmp_sql & " 						) "
                tmp_sql = tmp_sql & " 					/*①比率指定のデータのうち、「代表」にチェックされているデータを取得 end*/ "
                tmp_sql = tmp_sql & " 					UNION "
                tmp_sql = tmp_sql & " 					/*②金額指定のデータのうち、金額が0円のデータを取得 sta*/ "
                tmp_sql = tmp_sql & " 					SELECT * FROM "
                tmp_sql = tmp_sql & " 					( "
                tmp_sql = tmp_sql & " 						SELECT "
                tmp_sql = tmp_sql & " 							 ROW_NUMBER()OVER(PARTITION BY bk_no,kn_no,so_no ORDER BY bk_no,kn_no,so_no,sokoza_no) AS [口座行No] "
                tmp_sql = tmp_sql & " 							,* "
                tmp_sql = tmp_sql & " 						FROM bk_sokin "
                tmp_sql = tmp_sql & " 					) AS BKS "
                tmp_sql = tmp_sql & " 					WHERE EXISTS "
                tmp_sql = tmp_sql & " 						( "
                tmp_sql = tmp_sql & " 							SELECT * FROM bk_kanri AS BKK "
                tmp_sql = tmp_sql & " 							WHERE BKS.bk_no = BKK.bk_no "
                tmp_sql = tmp_sql & " 							AND   BKS.kn_no = BKK.kn_no "
