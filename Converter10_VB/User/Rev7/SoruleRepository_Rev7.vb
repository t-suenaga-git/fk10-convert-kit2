                'tmp_sql = tmp_sql & " 		WHEN yobi_si1 = 3 THEN 1 "
                'tmp_sql = tmp_sql & " 	 ELSE 0 "
                'tmp_sql = tmp_sql & " 	 END AS [部屋毎定額 - 部屋毎日割りフラグ] "
                'tmp_sql = tmp_sql & " 	,CASE "
                'tmp_sql = tmp_sql & " 		WHEN kn_tesu_kbn = 3 THEN tesu_gaku "
                'tmp_sql = tmp_sql & " 		ELSE NULL "
                'tmp_sql = tmp_sql & " 	 END AS [物件毎定額 - 物件管理手数料]	 "
                'tmp_sql = tmp_sql & " 	,tesu_zei AS [管理手数料 消費税適用フラグ] "
                'tmp_sql = tmp_sql & " 	,'' AS [備考 - 基本情報] "
                'tmp_sql = tmp_sql & " 	,0 AS [支払明細書関連 - 同時契約の場合は代表する部屋を表示] "
                'tmp_sql = tmp_sql & " 	,0 AS [支払明細書関連 - 口座毎に支払明細書を作成1]		/*ヘッダー名が同一なので1、2で分けておく*/ "
                'tmp_sql = tmp_sql & " 	,-1 AS [支払明細書関連 - 口座毎に支払明細書を作成2]		/*ヘッダー名が同一なので1、2で分けておく*/ "
                'tmp_sql = tmp_sql & " 	,-1 AS [部屋毎一括借上額 - 入金項目No1] "
                'tmp_sql = tmp_sql & " 	,-1 AS [部屋毎一括借上額 - 入金項目No2] "
                'tmp_sql = tmp_sql & " 	,-1 AS [部屋毎一括借上額 - 入金項目No3] "
                'tmp_sql = tmp_sql & " 	,-1 AS [部屋毎一括借上額 - 入金項目No4] "
                'tmp_sql = tmp_sql & " 	,-1 AS [部屋毎一括借上額 - 入金項目No5] "
                'tmp_sql = tmp_sql & " 	,yobi_bt5 AS [管理手数料計算基準区分] "
                'tmp_sql = tmp_sql & " 	,0 AS [満額入金-送金フラグ] "
                'tmp_sql = tmp_sql & " 	,zuiji_sokin AS [仲介物件 - 随時送金] "
                'tmp_sql = tmp_sql & " 	,1 AS [一括借上 部屋毎一括借上額の計算方法] "
                'tmp_sql = tmp_sql & " 	,0 AS [一括借上 消費税適用フラグ] "
                'tmp_sql = tmp_sql & " 	/*,'' AS [内税フラグ]*/		/*タケツーカスタマイズ*/ "
                'tmp_sql = tmp_sql & " 	/*,'' AS [soymd_basis]*/	/*使用箇所不明*/ "
                'tmp_sql = tmp_sql & " FROM "
                'tmp_sql = tmp_sql & " ( "
                'tmp_sql = tmp_sql & " 	SELECT "
                'tmp_sql = tmp_sql & " 		 BKK.* "
                'tmp_sql = tmp_sql & " 		,HASUUUKETORIKOZANO.[端数受取口座行No] "
                'tmp_sql = tmp_sql & " 		,KINGAKSITEIKOZA.[金額指定口座数] "
                'tmp_sql = tmp_sql & " 	FROM bk_kanri AS BKK "
                'tmp_sql = tmp_sql & " 	LEFT JOIN "
                'tmp_sql = tmp_sql & " 		( "
                'tmp_sql = tmp_sql & " 			/*物件送金先情報から端数受取口座の行Noを取得する sta*/ "
                'tmp_sql = tmp_sql & " 			SELECT "
                'tmp_sql = tmp_sql & " 				 bk_no "
                'tmp_sql = tmp_sql & " 				,kn_no "
                'tmp_sql = tmp_sql & " 				,so_no "
                'tmp_sql = tmp_sql & " 				,sokoza_no "
                'tmp_sql = tmp_sql & " 				,[口座行No] AS [端数受取口座行No] "
                'tmp_sql = tmp_sql & " 			FROM "
                'tmp_sql = tmp_sql & " 			( "
                'tmp_sql = tmp_sql & " 				/*①比率指定のデータのうち、「代表」にチェックされているデータを取得*/ "
                'tmp_sql = tmp_sql & " 				SELECT * FROM "
                'tmp_sql = tmp_sql & " 				( "
                'tmp_sql = tmp_sql & " 					SELECT "
                'tmp_sql = tmp_sql & " 						 ROW_NUMBER()OVER(PARTITION BY bk_no,kn_no,so_no ORDER BY bk_no,kn_no,so_no,sokoza_no) AS [口座行No] "
                'tmp_sql = tmp_sql & " 						,* "
                'tmp_sql = tmp_sql & " 					FROM bk_sokin "
                'tmp_sql = tmp_sql & " 				) AS BKS "
                'tmp_sql = tmp_sql & " 				WHERE EXISTS "
                'tmp_sql = tmp_sql & " 					( "
                'tmp_sql = tmp_sql & " 						SELECT * FROM bk_kanri AS BKK "
                'tmp_sql = tmp_sql & " 						WHERE BKS.bk_no = BKK.bk_no "
                'tmp_sql = tmp_sql & " 						AND   BKS.kn_no = BKK.kn_no "
                'tmp_sql = tmp_sql & " 						AND   BKK.sokin_kbn = 0 "
                'tmp_sql = tmp_sql & " 						AND   BKS.daihyo = 1 "
                'tmp_sql = tmp_sql & " 					) "
                'tmp_sql = tmp_sql & " 				/*①比率指定のデータのうち、「代表」にチェックされているデータを取得*/ "
                'tmp_sql = tmp_sql & " 				UNION "
                'tmp_sql = tmp_sql & " 				/*②金額指定のデータのうち、金額が0円のデータを取得*/ "
                'tmp_sql = tmp_sql & " 				SELECT * FROM "
                'tmp_sql = tmp_sql & " 				( "
                'tmp_sql = tmp_sql & " 					SELECT "
                'tmp_sql = tmp_sql & " 						 ROW_NUMBER()OVER(PARTITION BY bk_no,kn_no,so_no ORDER BY bk_no,kn_no,so_no,sokoza_no) AS [口座行No] "
                'tmp_sql = tmp_sql & " 						,* "
                'tmp_sql = tmp_sql & " 					FROM bk_sokin "
                'tmp_sql = tmp_sql & " 				) AS BKS "
                'tmp_sql = tmp_sql & " 				WHERE EXISTS "
                'tmp_sql = tmp_sql & " 					( "
                'tmp_sql = tmp_sql & " 						SELECT * FROM bk_kanri AS BKK "
                'tmp_sql = tmp_sql & " 						WHERE BKS.bk_no = BKK.bk_no "
                'tmp_sql = tmp_sql & " 						AND   BKS.kn_no = BKK.kn_no "
                'tmp_sql = tmp_sql & " 						AND   BKK.sokin_kbn = 1 "
                'tmp_sql = tmp_sql & " 						AND   BKS.yobi_kn1 = 0 "
                'tmp_sql = tmp_sql & " 					) "
                'tmp_sql = tmp_sql & " 				/*②金額指定のデータのうち、金額が0円のデータを取得*/ "
                'tmp_sql = tmp_sql & " 			) AS VW "
                'tmp_sql = tmp_sql & " 			/*物件送金先情報から端数受取口座の行Noを取得する end*/ "
                'tmp_sql = tmp_sql & " 		) AS HASUUUKETORIKOZANO "
                'tmp_sql = tmp_sql & " 	ON  BKK.bk_no = HASUUUKETORIKOZANO.bk_no "
                'tmp_sql = tmp_sql & " 	AND BKK.kn_no = HASUUUKETORIKOZANO.kn_no "
                'tmp_sql = tmp_sql & " 	LEFT JOIN "
                'tmp_sql = tmp_sql & " 		( "
                'tmp_sql = tmp_sql & " 			/*物件送金先情報から金額指定されている口座数を取得する sta*/ "
                'tmp_sql = tmp_sql & " 			SELECT * FROM "
                'tmp_sql = tmp_sql & " 			( "
                'tmp_sql = tmp_sql & " 				SELECT "
                'tmp_sql = tmp_sql & " 					 bk_no "
                'tmp_sql = tmp_sql & " 					,kn_no "
                'tmp_sql = tmp_sql & " 					,so_no "
                'tmp_sql = tmp_sql & " 					,MAX([金額指定口座No]) AS [金額指定口座数] "
                'tmp_sql = tmp_sql & " 				FROM "
                'tmp_sql = tmp_sql & " 					( "
                'tmp_sql = tmp_sql & " 						SELECT "
                'tmp_sql = tmp_sql & " 							 ROW_NUMBER()OVER(PARTITION BY bk_no,kn_no,so_no ORDER BY bk_no,kn_no,so_no) AS [金額指定口座No] "
                'tmp_sql = tmp_sql & " 							,* "
                'tmp_sql = tmp_sql & " 						FROM bk_sokin "
                'tmp_sql = tmp_sql & " 					) AS BKS "
                'tmp_sql = tmp_sql & " 					WHERE EXISTS "
                'tmp_sql = tmp_sql & " 						( "
                'tmp_sql = tmp_sql & " 							SELECT * FROM bk_kanri AS BKK "
                'tmp_sql = tmp_sql & " 							WHERE BKS.bk_no = BKK.bk_no "
                'tmp_sql = tmp_sql & " 							AND   BKS.kn_no = BKK.kn_no "
                'tmp_sql = tmp_sql & " 							AND   BKK.sokin_kbn = 1 "
                'tmp_sql = tmp_sql & " 							AND   BKS.yobi_kn1 <> 0 "
                'tmp_sql = tmp_sql & " 						) "
                'tmp_sql = tmp_sql & " 				GROUP BY bk_no,kn_no,so_no "
                'tmp_sql = tmp_sql & " 			) AS VW "
                'tmp_sql = tmp_sql & " 			/*物件送金先情報から金額指定されている口座数を取得する end*/ "
                'tmp_sql = tmp_sql & " 		) AS KINGAKSITEIKOZA "
                'tmp_sql = tmp_sql & " 	ON  BKK.bk_no = KINGAKSITEIKOZA.bk_no "
                'tmp_sql = tmp_sql & " 	AND BKK.kn_no = KINGAKSITEIKOZA.kn_no "
                'tmp_sql = tmp_sql & " ) AS SORULEMOTO "

