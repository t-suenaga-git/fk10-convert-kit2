                tmp_sql = tmp_sql & " 		AND BKK.kn_no = KINGAKGOKEI.kn_no	 "
                tmp_sql = tmp_sql & " 	) AS SORULEMOTO "
                tmp_sql = tmp_sql & " 	/*20160520 送金ルール抽出内容の修正 add sta*/ "
                tmp_sql = tmp_sql & " 	/*V7では物件管理情報有り、物件送金情報無しの状態が許されているが、10では許されていないため予め除外しておく*/ "
                tmp_sql = tmp_sql & " 	/*20161107 自社物件の送金ルール作成方法修正 chg sta*/ "
                tmp_sql = tmp_sql & " 	/*自社物件は送金先情報が必要ないため、10に移行する際に送金先情報無しで送金ルールを作成するように修正*/ "
                tmp_sql = tmp_sql & " 	/* "
                tmp_sql = tmp_sql & " 	WHERE EXISTS "
                tmp_sql = tmp_sql & " 		( "
                tmp_sql = tmp_sql & " 			SELECT * FROM bk_sokin AS BKS WHERE SORULEMOTO.bk_no = BKS.bk_no AND SORULEMOTO.kn_no = BKS.kn_no "
                tmp_sql = tmp_sql & " 		) "
                tmp_sql = tmp_sql & " 	*/ "
                tmp_sql = tmp_sql & " 	WHERE kn_kei = 4 "
                tmp_sql = tmp_sql & " 	OR EXISTS "
                tmp_sql = tmp_sql & " 		( "
                tmp_sql = tmp_sql & " 			SELECT * FROM bk_sokin AS BKS WHERE SORULEMOTO.bk_no = BKS.bk_no AND SORULEMOTO.kn_no = BKS.kn_no "
                tmp_sql = tmp_sql & " 		) "
                tmp_sql = tmp_sql & " 	/*20161107 自社物件の送金ルール作成方法修正 chg end*/ "
                tmp_sql = tmp_sql & " 	/*20160520 送金ルール抽出内容の修正 add end*/ "
                tmp_sql = tmp_sql & " ) AS VW "

