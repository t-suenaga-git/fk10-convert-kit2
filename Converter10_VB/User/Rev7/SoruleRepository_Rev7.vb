                tmp_sql = tmp_sql & " 					,so_no "
                tmp_sql = tmp_sql & " 					,sokoza_no "
                tmp_sql = tmp_sql & " 					,[口座行No] AS [端数受取口座行No] "
                tmp_sql = tmp_sql & " 				FROM "
                tmp_sql = tmp_sql & " 				( "
                tmp_sql = tmp_sql & " 					/*①比率指定のデータのうち、「代表」にチェックされているデータを取得 sta*/ "
                tmp_sql = tmp_sql & " 					SELECT * FROM "
