                'tmp_sql = tmp_sql & " SELECT * FROM "
                tmp_sql = tmp_sql & " SELECT " & tmp_chgmidheader & " FROM "
                tmp_sql = tmp_sql & " ( "
                tmp_sql = tmp_sql & " 	/*部屋入金項目情報から実データ抽出 sta*/ "
                tmp_sql = tmp_sql & " 	SELECT "
                tmp_sql = tmp_sql & " 		 HYKANRI.bk_no AS [物件No] "
                tmp_sql = tmp_sql & " 		,'' AS [部屋No] "
                tmp_sql = tmp_sql & " 		,BKK.kn_no AS [送金ルール管理No] "
                tmp_sql = tmp_sql & " 		,[月々/契約時/更新時区分] "
                tmp_sql = tmp_sql & " 		,ROW_NUMBER()OVER(PARTITION BY HYKANRI.bk_no,BKK.kn_no,[月々/契約時/更新時区分] ORDER BY HYKANRI.nkin_no) AS [行NO] "
