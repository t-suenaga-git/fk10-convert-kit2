                tmp_sql = tmp_sql & " 						) "
                tmp_sql = tmp_sql & " 					/*②金額指定のデータのうち、金額が0円のデータを取得 end*/ "
                tmp_sql = tmp_sql & " 				) AS VW "
                tmp_sql = tmp_sql & " 				/*物件送金先情報から端数受取口座の行Noを取得する end*/ "
                tmp_sql = tmp_sql & " 			) AS HASUUUKETORIKOZANO "
                tmp_sql = tmp_sql & " 		ON  BKK.bk_no = HASUUUKETORIKOZANO.bk_no "
                tmp_sql = tmp_sql & " 		AND BKK.kn_no = HASUUUKETORIKOZANO.kn_no "
                tmp_sql = tmp_sql & " 		LEFT JOIN "
                tmp_sql = tmp_sql & " 			( "
                tmp_sql = tmp_sql & " 				/*物件送金先情報から金額指定されている口座数を取得する sta*/ "
                tmp_sql = tmp_sql & " 				SELECT "
                tmp_sql = tmp_sql & " 					 bk_no "
                tmp_sql = tmp_sql & " 					,kn_no "
                tmp_sql = tmp_sql & " 					,so_no "
                tmp_sql = tmp_sql & " 					,MAX([金額指定口座No]) AS [金額指定口座数] "
                tmp_sql = tmp_sql & " 				FROM "
                tmp_sql = tmp_sql & " 				(			 "
                tmp_sql = tmp_sql & " 					SELECT "
                tmp_sql = tmp_sql & " 						 ROW_NUMBER()OVER(PARTITION BY bk_no,kn_no,so_no ORDER BY bk_no,kn_no,so_no) AS [金額指定口座No] "
                tmp_sql = tmp_sql & " 						,* "
                tmp_sql = tmp_sql & " 					FROM "
                tmp_sql = tmp_sql & " 					(		 "
                tmp_sql = tmp_sql & " 						SELECT * FROM bk_sokin WHERE yobi_kn1 <> 0 "
                tmp_sql = tmp_sql & " 					) AS VW "
                tmp_sql = tmp_sql & " 				) AS VW2 "
                tmp_sql = tmp_sql & " 				GROUP BY bk_no,kn_no,so_no "
