            ''' テーブル[m_syogo_cnvptn]への移行(xmlとTableの両方で設定されているため)
            ''' </summary>
            ''' <param name="sqlcnnv10"></param>
            ''' <param name="tblname"></param>
            ''' <param name="model_cvitem"></param>
            ''' <returns></returns>
            ''' <remarks></remarks>
            Public Function Set_HenkanValueToTable(ByVal sqlcnnv10 As SqlConnection, ByVal tblname As String, ByVal model_cvitem As Njc.Model.Profile_fk_henkanmoji_Model) As Boolean

                Dim normalflg As Boolean = True
                Dim tmp_hash As New Hashtable
                Dim fldnamegrp As String = "system_kbn,cnv_no,cnv_ptn,cnv_replaceoldmoji,cnv_replacenewmoji"

                Dim tmp_system_kbn As String = "3"
                Dim tmp_cnv_no As String = IIf(model_cvitem.Vari_No Is Nothing, "", model_cvitem.Vari_No)
                Dim tmp_cnv_ptn As String = "0"
                Dim tmp_cnv_replaceoldmoji As String = IIf(model_cvitem.Vari_Target Is Nothing, "''", "'" & Me.Chg_Str10ToTableValue(model_cvitem.Vari_Target) & "'")
                Dim tmp_cnv_replacenewmoji As String = IIf(model_cvitem.Vari_Cnv Is Nothing, "''", "'" & Me.Chg_Str10ToTableValue(model_cvitem.Vari_Cnv) & "'")

                Dim insertvalue As String = tmp_system_kbn & "," & tmp_cnv_no & "," & tmp_cnv_ptn & "," & tmp_cnv_replaceoldmoji & "," & tmp_cnv_replacenewmoji

                '挿入処理
                Dim tmp_cnt As Integer = 0
                Dim tmp_sql_table As String = "INSERT INTO " & tblname & " VALUES(" & insertvalue & ")"
                normalflg = DBExec.Exec_NonQuery(sqlcnnv10, tmp_sql_table, tmp_cnt)

                Return normalflg

            End Function

            ''' <summary>
            ''' 照合用文字列の置換処理(契約者照合用カナが対象) '20160622 照合用文字変換対応
            ''' </summary>
            ''' <param name="sqlcnnv10"></param>
            ''' <remarks></remarks>
            Public Sub Chg_KysSyogomoji(ByVal sqlcnnv10 As SqlConnection)

                Dim list_taisyo As New List(Of String)      '対象データ格納用

                '対象データ抽出クエリ作成
                Dim tmp_sql As String = ""
                tmp_sql = tmp_sql & " SELECT "
                tmp_sql = tmp_sql & " 	CONVERT(VARCHAR,sqsaki_kbn) + '-' + CONVERT(VARCHAR,sqsaki_no) + '-' + CONVERT(VARCHAR,sqsaki_kozano) "
                tmp_sql = tmp_sql & " FROM m_fb_fkomsyogo "
                tmp_sql = tmp_sql & " WHERE sqsaki_kbn = 100 "
                DBExec.Exec_DataReader_Col_List(tmp_sql, sqlcnnv10, list_taisyo)

                'メイン処理
                For Each sqsaki In list_taisyo

                    '分割
                    Dim tmp_sqsaki() As String = sqsaki.Split("-")

                    '置換処理用クエリ作成
                    Dim tmp_sql_replace As String = ""
                    tmp_sql_replace = tmp_sql_replace & " EXEC usp_fb_CreateSyogoMj "
                    tmp_sql_replace = tmp_sql_replace & tmp_sqsaki(0)
                    tmp_sql_replace = tmp_sql_replace & ","
                    tmp_sql_replace = tmp_sql_replace & tmp_sqsaki(1)
                    tmp_sql_replace = tmp_sql_replace & ","
                    tmp_sql_replace = tmp_sql_replace & tmp_sqsaki(2)

                    '実行
                    Dim tmpcnt As Integer = 0
                    DBExec.Exec_NonQuery(sqlcnnv10, tmp_sql_replace, tmpcnt)

                Next

            End Sub

