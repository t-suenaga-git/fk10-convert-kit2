            ''' <summary>
            ''' 入金区分の紐付設定値を取得
            ''' </summary>
            ''' <param name="fldname"></param>
            ''' <param name="value"></param>
            ''' <param name="chgvalue"></param>
            ''' <remarks></remarks>
            Public Function Set_Nkinkbn(ByVal fldname As String, ByVal value As String) As String

                Dim rtn_str As String = ""
                Dim defvalue As String = ""
                Select Case fldname
                    Case "新規契約時の入金方法_通常更新解約月"
                        defvalue = "2"
                    Case "新規契約時の入金方法_契約契約更新一時金"
                        defvalue = "1"
                End Select

                If Hash_Rel_Nkinkbn.Contains(value) Then
                    rtn_str = Hash_Rel_Nkinkbn.Item(value)
                Else
                    rtn_str = defvalue
                    'ログ
                End If

                Return rtn_str

            End Function

            ''' <summary>
            ''' 送金ルール初期入金項目の滞納保証設定
            ''' </summary>
            ''' <param name="sqlcnnv10"></param>
            ''' <param name="tblname"></param>
            ''' <param name="fldvalue"></param>
            ''' <remarks></remarks>
            Public Sub Set_TainoHosyoXml(ByVal sqlcnnv10 As SqlConnection, ByVal tblname As String, ByVal fldvalue As String)

                Dim list_updatefld As New List(Of String) From {"sorulemaitukidefine", "sorulehendodefine", "sorulesonotasqdefine"}
                Dim tmp_xmlpath As String = "/ArrayOfSoRuleDefine/SoRuleDefine[]/TainoHosyoFlg"
                Dim maxrowcnt As Integer = 20   '画面上で20以上登録可能だが初期表示では20が最大なのでこの値を最大にしておく

                For Each fldname In list_updatefld

                    For cntii = 1 To maxrowcnt

                        '抽出し、値の有無を確認する
                        Dim xmlpath As String = tmp_xmlpath.Replace("[]", "[" & cntii.ToString & "]")
                        Dim tmp_sql As String = ""
                        tmp_sql = tmp_sql & " SELECT " & fldname & ".query('"
                        tmp_sql = tmp_sql & xmlpath
                        tmp_sql = tmp_sql & "') FROM " & tblname

                        Dim value As String
                        value = DBExec.Exec_Scalar(tmp_sql, sqlcnnv10)

                        If value.Trim = "" Then
                            '値が存在しない場合は処理を抜け、次のフィールドへ移る
                            Exit For
                        Else
                            '更新
                            Dim tmp_cnt As Integer = 0
                            Dim normalflg As Boolean = True
                            Dim tmp_xmlupdate_sql As String = Me.Get_UseQry(tblname, fldname, xmlpath, fldvalue)
                            normalflg = DBExec.Exec_NonQuery(sqlcnnv10, tmp_xmlupdate_sql, tmp_cnt)
                        End If

                    Next

                Next

            End Sub

            ''' <summary>
            ''' XMLを更新するクエリ
            ''' </summary>
            ''' <param name="fldname"></param>
            ''' <param name="xpath"></param>
            ''' <param name="value"></param>
            ''' <returns></returns>
            ''' <remarks></remarks>
            Public Function Get_UseQry(ByVal tblname As String, ByVal fldname As String, ByVal xpath As String, ByVal value As String) As String

                Dim tmp_sql As String = ""
                tmp_sql = tmp_sql & " UPDATE " & tblname & " SET "
                tmp_sql = tmp_sql & fldname
                tmp_sql = tmp_sql & ".modify('replace value of( "
                tmp_sql = tmp_sql & xpath
                tmp_sql = tmp_sql & "/text())[1] with("
                tmp_sql = tmp_sql & """" & value & """"
                tmp_sql = tmp_sql & ")') "

                Return tmp_sql

            End Function

