                                Case "入金項目区分16"
                                    tmp_nkinkbn(16) = fldvalue
                                Case "入金項目名16"
                                    tmp_nkinname(16) = fldvalue
                                Case "入金項目区分17"
                                    tmp_nkinkbn(17) = fldvalue
                                Case "入金項目名17"
                                    tmp_nkinname(17) = fldvalue
                                Case "入金項目区分18"
                                    tmp_nkinkbn(18) = fldvalue
                                Case "入金項目名18"
                                    tmp_nkinname(18) = fldvalue
                                Case "入金項目区分19"
                                    tmp_nkinkbn(19) = fldvalue
                                Case "入金項目名19"
                                    tmp_nkinname(19) = fldvalue
                                Case "入金項目区分20"
                                    tmp_nkinkbn(20) = fldvalue
                                Case "入金項目名20"
                                    tmp_nkinname(20) = fldvalue
                            End Select

                        Next

                        '固定値
                        .Vari_Identity = Guid.NewGuid.ToString

                        '入金項目変換
                        For cntkk = 1 To 20
                            Call Me.Set_Nkinkomkno(model_cvitem, tmp_nkinname(cntkk), tmp_nkinkbn(cntkk), cntkk)
                        Next

                        '20160817 営業指摘対応 xmlエラー修正 -add sta
                        '代表入金項目Noの調整
                        Dim tmp_daihyonkin As String = ""
                        If model_cvitem.Vari_DaihyoNkinNo IsNot Nothing Then
                            tmp_daihyonkin = model_cvitem.Vari_DaihyoNkinNo
                        Else
                            tmp_daihyonkin = ""
                        End If
                        If tmp_daihyonkin = "" Then
                            model_cvitem.Vari_DaihyoNkinNo = "0"
                        End If
                        '20160817 営業指摘対応 xmlエラー修正 -add end

                        'xml更新処理
                        normalflg = Me.Set_XmlValue(sqlcnnv10, tmp_syuyakukbn, model_cvitem, tmp_insertno)
                        If normalflg Then
                            tmp_cvcnt = tmp_cvcnt + 1
                        End If

                        '-------------------------------
                        'プログレスバー更新/進捗率表示
                        '-------------------------------
                        '件数取得
                        Dim pgbcnt As Integer = 0
                        If rowcnt <= pgbbasecnt Then        '基準件数(100件)以下の場合は実件数を取得
                            pgbcnt = cntii
                        ElseIf rowcnt > cntii + 1 Then      '基準件数(100件)より大きい、かつ最終レコードに達していない場合は100件毎に値を取得
                            Call EtcMethod.Get_MultipleFlg(cntii + 1, pgbbasecnt, pgbcnt)
                        ElseIf rowcnt <= cntii + 1 Then     '基準件数(100件)より大きい、かつ最終レコードに達した場合はプログレスバーの総件数を取得
                            pgbcnt = pgbtotalcnt
                        End If

                        '表示
                        If pgbcnt <> 0 Then
                            Call obj_pgb.pgbsettingPart(pgbcnt)
                            Call obj_com.ProgressOutPut(pgbcnt, pgbtotalcnt)
                        End If

                    Next

                End With

                '************************
                '終了処理
                '************************

                '中間ファイル件数を取得
                midrowcnt = rowcnt

                '移行件数を取得
                cvrowcnt = tmp_cvcnt

                '調整件数を取得
                conditioncnt = tmp_condcnt

                'Excelファイル終了設定
                Call excelfile.Set_ExcelFile_ReadClose(appli, wbook, wsheet)

                '返却
                Return rtn

            End Function

