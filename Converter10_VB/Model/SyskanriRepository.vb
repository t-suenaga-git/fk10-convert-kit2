            Public Function Chg_Str10ToTableValue(ByVal value As String) As String

                Dim rtn_str As String = ""

                Select Case value
                    Case "&amp;{sp}"
                        rtn_str = " "
                    Case Else
                        rtn_str = value
                End Select

                Return rtn_str

            End Function

