            ''' <summary>
            ''' 文字列変換(V7→10)
            ''' </summary>
            ''' <param name="value"></param>
            ''' <returns></returns>
            ''' <remarks></remarks>
            Public Function Chg_StrV7To10Value(ByVal value As String) As String

                Dim rtn_str As String = ""

                Select Case value
                    Case " "
                        rtn_str = "&amp;{sp}"
                    Case "シングル"
                        rtn_str = "＇"
                    Case "ダブル"
                        rtn_str = """"
                    Case Else
                        rtn_str = value
                End Select

                Return rtn_str

            End Function

