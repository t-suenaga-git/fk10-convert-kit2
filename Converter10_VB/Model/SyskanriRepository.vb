            ''' <summary>
            ''' 入金項目の紐付設定値を取得
            ''' </summary>
            ''' <param name="value"></param>
            ''' <returns></returns>
            ''' <remarks></remarks>
            Public Sub Set_Nkinkomkno(ByRef model_cvitem As Njc.Model.Profile_fk_nkinkomkmerge_Model, ByVal nkinname As String, ByVal nkinkbn As String, ByVal cnt As Integer)

                If nkinname.Trim = "" Then
                    Exit Sub
                End If

                Dim tmp_syogonkinname As String = nkinname & "-" & EtcMethod.Get_Nkinruiname(nkinkbn)

                If Hash_Rel_Nkinkomk.Contains(tmp_syogonkinname) Then
                    model_cvitem.Vari_Int(cnt) = Hash_Rel_Nkinkomk.Item(tmp_syogonkinname)
                    If cnt = 1 Then
                        model_cvitem.Vari_DaihyoNkinNo = Hash_Rel_Nkinkomk.Item(tmp_syogonkinname)
                    End If
                Else
                    model_cvitem.Vari_Int(cnt) = ""
                End If

            End Sub

            ''' <summary>
            ''' 初期化処理→挿入処理
            ''' </summary>
            ''' <param name="sqlcnnv10"></param>
            ''' <param name="syuyakukbn"></param>
            ''' <param name="model_cvitem"></param>
            ''' <param name="cnt"></param>
            ''' <remarks></remarks>
            Public Function Set_XmlValue(ByVal sqlcnnv10 As SqlConnection, ByVal syuyakukbn As String, ByVal model_cvitem As Njc.Model.Profile_fk_nkinkomkmerge_Model, ByVal cnt As Integer) As Boolean

                Dim normalflg As Boolean = True

                '親要素名設定
                Dim tag_base As String = "ApplicationDefine"

                '集約区分から更新先の親要素名を設定
                Dim tag_syuyakubase As String = ""
                Select Case syuyakukbn
                    Case "収支一覧"
                        tag_syuyakubase = "SyusiMeiNkinGrouping"
                    Case "物件別収支一覧"
                        tag_syuyakubase = "BkSyusiMeiNkinGrouping"
                End Select

                '更新する要素が格納されているタグの名称設定
                Dim tmp_tag_taisyo As String = "/" & tag_base & "/" & tag_syuyakubase & "/SettingRecordList/UserDefineSettingRecordModel[]"

                '更新先の要素名設定
                Dim list_tag As New List(Of String) From _
                    {"Identity", "Name", "NkinNoList", "NkinRuiList", "NkinZkseiList", "DaihyoNkinNo", "ProhibitDelete", "ProhibitChangeTitle", "ProhibitChangeSettings", "ProhibitMove"}

                If model_cvitem.Vari_Name <> "" Then

                    '更新先のxpathに番号を振る
                    Dim tag_taisyo As String = tmp_tag_taisyo.Replace("[]", "[" & cnt.ToString & "]")

                    '初期化用のクエリ作成
                    Dim tag_delete As String = "UPDATE profile_fk SET applicationdefine.modify('delete(" & tag_taisyo

                    '更新先の初期化
                    For Each deleteitem In list_tag
                        tag_delete = tag_delete & "/" & deleteitem & ")')"
                        Dim tmp_cnt As Integer = 0
                        normalflg = DBExec.Exec_NonQuery(sqlcnnv10, tag_delete, tmp_cnt)
                        If normalflg = False Then
                            Return normalflg
                        End If
                        tag_delete = tag_delete.Replace("/" & deleteitem & ")')", "")
                    Next

                    '挿入処理実行
                    normalflg = Me.Set_XmlValue_Insert(sqlcnnv10, tag_taisyo, model_cvitem)
                    If normalflg = False Then
                        Return normalflg
                    End If

                End If

                Return normalflg

            End Function

